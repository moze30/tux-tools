#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"
IDI_LOGO ICON "penguin.ico"

1 RT_MANIFEST "Application.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tux-Tools"
            VALUE "FileDescription", "GPU capability viewer and Direct3D driver test"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Tux-Tools"
            VALUE "OriginalFilename", "Tux-Tools.exe"
            VALUE "ProductName", "Tux-Tools"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
